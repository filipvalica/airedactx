{
  "manifest_version": 3,
  "name": "AIRedactX",
  "description": "Redact personal data and secrets from text fields before you send them to a chatbot or website. Runs entirely in your browser.",
  "permissions": ["storage", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "AIRedactX: open rules and settings",
    "default_icon": "icons/icon-48.svg"
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{764f978b-9df0-4862-ba11-20075954872e}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["injected-styles.css", "icons/icon-48.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["injected-styles.css"],
      "all_frames": true
    }
  ]
}
