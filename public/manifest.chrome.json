{
  "manifest_version": 3,
  "name": "AIRedactX",
  "description": "Redact personal data and secrets from text fields before you send them to a chatbot or website. Runs entirely in your browser.",
  "permissions": ["storage", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AIRedactX: open rules and settings",
    "default_icon": {
      "48": "icons/icon-48.svg"
    }
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.svg"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected-styles.css", "icons/icon-48.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["injected-styles.css"],
      "all_frames": true
    }
  ]
}
