{
  "name": "airedactx-extension",
  "version": "1.4.0",
  "description": "Browser extension that redacts personal data and secrets from text fields before submission. Fully client-side.",
  "type": "module",
  "scripts": {
    "prebuild": "rimraf dist",
    "build:ui": "vite build --config vite.config.ts",
    "build:background": "vite build --config vite.background.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "build": "npm run build:ui && npm run build:background && npm run build:content",
    "build:firefox": "cross-env BROWSER=firefox npm run build",
    "build:chrome": "cross-env BROWSER=chrome npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint:code": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json}\"",
    "lint": "web-ext lint --source-dir dist",
    "package": "web-ext build --source-dir dist --artifacts-dir web-ext-artifacts --overwrite-dest",
    "check": "npm run typecheck && npm run lint:code && npm run format:check && npm test && npm run build:firefox && npm run lint"
  },
  "keywords": [
    "browser-extension",
    "firefox",
    "privacy",
    "redaction",
    "pii"
  ],
  "author": "filipvalica",
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.6.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/webextension-polyfill": "^0.12.3",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "rimraf": "^5.0.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.7",
    "web-ext": "^8.10.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/filipvalica/airedactx.git"
  },
  "engines": {
    "node": ">=20"
  }
}
